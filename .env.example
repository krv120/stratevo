# Local development only; never put live values in source or chat.
PUBLIC_BASE_URL=https://www.stratevo.online
SITE_INDEXABLE=false
SITE_LAUNCH_APPROVED=false
# Set true only after verifying the trusted public HTTPS origin.
PUBLIC_ORIGIN_VERIFIED=false
# Strong unique secret, no default. Set either password or token.
ADMIN_PASSWORD=
ADMIN_TOKEN=
# Optional: when set, MFA is required.
ADMIN_TOTP_SECRET=
# Use durable PostgreSQL and true for real production submissions.
DATABASE_URL=
STRICT_PERSISTENT_DB=false
# Serverless /tmp SQLite is ephemeral, per-instance and not a backup.
MAIL_DELIVERY_ENABLED=false
ADMIN_NOTIFICATION_EMAIL=
MAIL_FROM=
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_WEBHOOK_URL=
RIGHTS_ERASURE_APPROVED=false

# --- Content Studio: fal.ai video generation -------------------------------
# Server-side only. Create an API-scoped key at https://fal.ai/dashboard/keys
# and store it in the hosting secret manager (Vercel: Project -> Settings ->
# Environment Variables -> FAL_KEY, Production). Never commit a value here.
FAL_KEY=
# Hard ceilings enforced before any generation is submitted.
VIDEO_SPEND_LIMIT_USD=5.00
VIDEO_MAX_JOB_USD=1.00
VIDEO_JOBS_PER_HOUR=6
# fal.ai completion callbacks; set false to rely on status polling only.
VIDEO_WEBHOOK_ENABLED=true
