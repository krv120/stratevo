# Optional private-research API token only. Customers do not need this. Never reuse exposed credentials.
APP_ACCESS_TOKEN=
PORT=8000
# OpenAI-compatible Chat Completions endpoint; provider must support function tools.
# Set this in hosting secrets; actual provider access must be tested there.
# Gemini example: https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_MAX_OUTPUT_TOKENS=4096
# Optional; Gemini 2.5 defaults to low. Other model/provider support varies.
AI_REASONING_EFFORT=

# Supplier workflow. Required on Vercel; use your private Supabase/Postgres SSL connection.
DATABASE_URL=
# Exact canonical public origin used to generate emails; never derived from request Host.
PUBLIC_BASE_URL=https://your-domain.example
# Generate with: python3 -m app.suppliers hash-password
ADMIN_PASSWORD_HASH=
COOKIE_SECURE=true
# STARTTLS required, usually port 587. No credentials go into browser code.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional, opt-in on-demand web discovery. Server-side credentials only.
ONLINE_DISCOVERY_ENABLED=false
BRAVE_SEARCH_API_KEY=
# Shared daily UTC request budget; failed provider attempts also count.
ONLINE_DISCOVERY_DAILY_LIMIT=50

# Anonymous customer AI. A missing provider configuration returns an honest unavailable state.
PUBLIC_AI_ENABLED=true
# Shared UTC daily model-request cap. Failed provider attempts count; not an exact money cap.
PUBLIC_AI_DAILY_LIMIT=100
# Shared in-flight leases expire after 90 seconds if a worker dies.
PUBLIC_AI_CONCURRENCY=3
# Per connection-address minute cap; shared proxies may share it. Global ceiling is 60/minute.
PUBLIC_AI_PER_MINUTE=10
