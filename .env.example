# Optional private-research API token only. Customers do not need this. Never reuse exposed credentials.
APP_ACCESS_TOKEN=
PORT=8000
# OpenAI-compatible Chat Completions endpoint; provider must support function tools.
# Set this in hosting secrets; actual provider access must be tested there.
# Gemini example: https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_MAX_OUTPUT_TOKENS=4096
# Optional; Gemini 2.5 defaults to low. Other model/provider support varies.
AI_REASONING_EFFORT=

# Supplier workflow. Required on Vercel; use your private Supabase/Postgres SSL connection.
DATABASE_URL=
# Exact canonical public origin used to generate emails; never derived from request Host.
PUBLIC_BASE_URL=https://your-domain.example
# Generate with: python3 -m app.suppliers hash-password
ADMIN_PASSWORD_HASH=
COOKIE_SECURE=true
# STARTTLS required, usually port 587. No credentials go into browser code.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional, opt-in on-demand web discovery. Server-side credentials only.
ONLINE_DISCOVERY_ENABLED=false
BRAVE_SEARCH_API_KEY=
# Shared daily UTC request budget; failed provider attempts also count.
ONLINE_DISCOVERY_DAILY_LIMIT=50

# Anonymous customer AI. A missing provider configuration returns an honest unavailable state.
PUBLIC_AI_ENABLED=true
# Shared UTC daily model-request cap. Failed provider attempts count; not an exact money cap.
PUBLIC_AI_DAILY_LIMIT=100
# Shared in-flight leases expire after 90 seconds if a worker dies.
PUBLIC_AI_CONCURRENCY=3
# Per connection-address minute cap; shared proxies may share it. Global ceiling is 60/minute.
PUBLIC_AI_PER_MINUTE=10

# Owner notifications (not the sender address). Set only a verified destination mailbox.
# Missing/invalid destination leaves persistent notification jobs awaiting configuration.
NOTIFICATION_EMAIL=
# Confirm the production apex/www redirect before changing this; not inferred from Host.
CANONICAL_BASE_URL=https://stratevo.online
# Keep false on previews and until legal/operator disclosures and live checks are complete.
SITE_INDEXABLE=false

# Only true for the embedded Arena preview. Production should retain same-origin framing.
ALLOW_PREVIEW_EMBEDDING=false

# Operational hardening (migration 005). Never reuse a production DB in a preview.
APP_ENV=local
# Must equal APP_ENV for non-local database deployments; operator attestation, not DB identity proof.
DATABASE_ENVIRONMENT=
PUBLIC_ORIGIN_VERIFIED=false
BOOKING_URL=https://app.minup.io/book/stratevo
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_VERIFIED=false
SITE_LAUNCH_APPROVED=false
# JSON array of {id,password_hash,totp_secret,disabled}; provision privately in hosting secrets.
# Production requires named accounts and a base32 TOTP secret of at least 20 decoded bytes.
ADMIN_ACCOUNTS_JSON=
# Enable only after sender authorization, TLS, recipients and staging delivery are approved.
MAIL_DELIVERY_ENABLED=false
# Random 32+ character hosting secret. Authenticated GET/POST /api/jobs/mail handles one job.
CRON_SECRET=
MAX_SUPPLIER_ACCOUNTS=2000
MAX_PENDING_SUPPLIERS=500
MAX_STORED_INQUIRIES=10000
MAX_STORED_PRODUCTS=20000
MAX_IMAGE_STORAGE_BYTES=268435456
MAX_OUTBOX_RECORDS=10000
IMAGE_PROCESSING_CONCURRENCY=2
# Blank means no business-data retention policy configured. Never guess legal periods.
RETENTION_DAYS_CLOSED_INQUIRIES=
RETENTION_DAYS_PENDING_SUPPLIERS=
RETENTION_DAYS_DOCUMENTS=
RETENTION_DAYS_OPERATIONS=
RETENTION_APPLY_APPROVED=false
RIGHTS_ERASURE_APPROVED=false

# Optional public webmaster verification values (not AI/hosting credentials).
# Obtain from the owner's verified Search Console / Bing Webmaster Tools setup.
# Presence of a tag alone does NOT establish successful verification or indexing.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Database URL priority (first non-empty wins): DATABASE_URL, STRATEVO_DATABASE_URL,
# POSTGRES_URL, POSTGRES_URL_NON_POOLING, NEON_DATABASE_URL, SUPABASE_DB_URL.
# Use PostgreSQL for shared durable production data. Poolers disable prepared statements.
STRATEVO_DATABASE_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
NEON_DATABASE_URL=
SUPABASE_DB_URL=
# Opt-in fail-closed mode. Recommended for real production submissions after provisioning PG.
# Without PG and strict mode, deployed runtimes use /tmp/stratevo_runtime.sqlite3.
# /tmp is EPHEMERAL, per-instance, not shared, not a backup or durable delivery guarantee.
STRICT_PERSISTENT_DB=false
