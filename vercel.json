{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{web/**,migrations/**}",
      "excludeFiles": "{private/**,tests/**,validation/**,*.md,RELEASE-SCREENSHOTS.html,MANIFEST.json,.env*,.git/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__stratevo_path=/$1"
    }
  ]
}
